{
	"name": "PL_SQL_ADLS",
	"properties": {
		"activities": [
			{
				"name": "Get_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.0:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select * from dbo.sql_ingestion_config",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_SERVER",
						"type": "DatasetReference",
						"parameters": {
							"server_name": {
								"value": "@pipeline().globalParameters.sql_ingestion_server_name",
								"type": "Expression"
							},
							"db_name": {
								"value": "@pipeline().globalParameters.sql_ingestion_db_name",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Iterate each config",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Config').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "check if any new data arrivied or not",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get Max Ts from table",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('Get Max Ts from table').output.firstRow.MaxWatermark,item().WatermarkValue)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Audit Stale Update",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_Update_Audit_Stale_data]",
											"storedProcedureParameters": {
												"AuditID": {
													"value": {
														"value": "@activity('Audit table entry').output.firstRow.AuditID",
														"type": "Expression"
													},
													"type": "Int32"
												},
												"WatermarkEndValue": {
													"value": {
														"value": "@activity('Get Max Ts from table').output.firstRow.MaxWatermark",
														"type": "Expression"
													},
													"type": "DateTime"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_SQL_SERVER",
											"type": "LinkedServiceReference",
											"parameters": {
												"sql_server_name": {
													"value": "@item().sql_server_name",
													"type": "Expression"
												},
												"sql_database_name": {
													"value": "@item().sql_server_database_name",
													"type": "Expression"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy data from sql to adls",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"sqlReaderStoredProcedureName": "[dbo].[usp_GetIncrementalPolicy2]",
												"storedProcedureParameters": {
													"table": {
														"type": "String",
														"value": {
															"value": "@item().sql_table_name",
															"type": "Expression"
														}
													},
													"WatermarkEndValue": {
														"type": "DateTime",
														"value": {
															"value": "@activity('Get Max Ts from table').output.firstRow.MaxWatermark",
															"type": "Expression"
														}
													},
													"WatermarkStart": {
														"type": "DateTime",
														"value": {
															"value": "@item().WatermarkValue",
															"type": "Expression"
														}
													}
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".csv"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_SQL_SERVER",
												"type": "DatasetReference",
												"parameters": {
													"server_name": {
														"value": "@item().sql_server_name",
														"type": "Expression"
													},
													"db_name": {
														"value": "@item().sql_server_database_name",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ADLS_TARGET",
												"type": "DatasetReference",
												"parameters": {
													"container": {
														"value": "@item().target_adls_container",
														"type": "Expression"
													},
													"folder": {
														"value": "@concat(item().target_adls_directory,formatDateTime(utcNow(),'yyyy-MM-dd'))",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Audit Success Update",
