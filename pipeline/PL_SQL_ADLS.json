													"type": "String"
												},
												"WatermarkEndValue": {
													"value": {
														"value": "@activity('Get Max Ts from table').output.firstRow.MaxWatermark",
														"type": "Expression"
													},
													"type": "DateTime"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_SQL_SERVER",
											"type": "LinkedServiceReference",
											"parameters": {
												"sql_server_name": {
													"value": "@item().sql_server_name",
													"type": "Expression"
												},
												"sql_database_name": {
													"value": "@item().sql_server_database_name",
													"type": "Expression"
												}
											}
										}
									},
									{
										"name": "Update Watermark",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Audit Success Update",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_UpdateWatermark]",
											"storedProcedureParameters": {
												"controlID": {
													"value": {
														"value": "@item().control_id",
														"type": "Expression"
													},
													"type": "Int32"
												},
												"WatermarkEnd": {
													"value": {
														"value": "@activity('Get Max Ts from table').output.firstRow.MaxWatermark",
														"type": "Expression"
													},
													"type": "DateTime"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_SQL_SERVER",
											"type": "LinkedServiceReference",
											"parameters": {
												"sql_server_name": {
													"value": "@item().sql_server_name",
													"type": "Expression"
												},
												"sql_database_name": {
													"value": "@item().sql_server_database_name",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						},
