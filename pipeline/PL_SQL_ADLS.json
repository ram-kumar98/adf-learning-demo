													"value": {
														"value": "@activity('Audit table entry').output.firstRow.AuditID",
														"type": "Expression"
													},
													"type": "Int32"
												},
												"RowsCopied": {
													"value": {
														"value": "@activity('Copy data from sql to adls').output.rowsRead",
														"type": "Expression"
													},
													"type": "Int32"
												},
												"RowsInserted": {
													"value": {
														"value": "@activity('Copy data from sql to adls').output.rowsCopied",
														"type": "Expression"
													},
													"type": "Int32"
												},
